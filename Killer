local azState = {
	AutoQTE = false,
	QTEMethod = "Instance",
	InfiniteQTE = false,
	GrabAim = false,
	GolemAim = false,
	GrabLead = 0.03,
	GrabMaxLead = 0.4,
	GrabWallCheck = false,
	GrabSmooth = 0.3,
	qteHooked = false,
	grabConn = nil,
	golemConn = nil,
}

local function azHookQTE()
	if azState.qteHooked then return true end
	if type(hookfunction) ~= "function" then return false end
	local ok, mod = pcall(function()
		return require(ReplicatedStorage.Assets.Killers.Azure.Config.cl_WorkaroundModules.cl_ConstructQTE)
	end)
	if not ok or type(mod) ~= "table" or type(mod.new) ~= "function" then return false end
	local origNew = mod.new
	mod.new = function(...)
		local qte = origNew(...)
		if qte then
			if azState.InfiniteQTE then pcall(function() qte.FailedAttempts = -math.huge end) end
			if azState.AutoQTE and azState.QTEMethod == "Instance" then
				task.defer(function()
					task.wait(0.12)
					if azState.AutoQTE and qte and type(qte.AddProgress) == "function" then
						pcall(function() qte:AddProgress(100) end)
					end
				end)
			end
		end
		return qte
	end
	azState.qteHooked = true
	return true
end

local function azGrabLoop()
	local char = LocalPlayer.Character
	if not char or char.Name ~= "Azure" then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local survivors = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Survivors")
	if not survivors then return end
	local best, bestD = nil, math.huge
	for _, s in ipairs(survivors:GetChildren()) do
		local sHrp = s:FindFirstChild("HumanoidRootPart")
		local hum = s:FindFirstChildOfClass("Humanoid")
		if sHrp and hum and hum.Health > 0 then
			local d = (sHrp.Position - hrp.Position).Magnitude
			if d < bestD then bestD = d; best = sHrp end
		end
	end
	if not best then return end
	local vel = best.AssemblyLinearVelocity or Vector3.zero
	local aimPos = best.Position + vel * azState.GrabLead
	Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, aimPos), azState.GrabSmooth)
	hrp.CFrame = CFrame.new(hrp.Position, Vector3.new(aimPos.X, hrp.Position.Y, aimPos.Z))
end

local function azSetGrabAim(on)
	azState.GrabAim = on
	if azState.grabConn then azState.grabConn:Disconnect() azState.grabConn = nil end
	if on then azState.grabConn = RunService.RenderStepped:Connect(azGrabLoop) end
end

local function azSetGolemAim(on)
	azState.GolemAim = on
	if azState.golemConn then azState.golemConn:Disconnect() azState.golemConn = nil end
	if on then
		azState.golemConn = RunService.RenderStepped:Connect(function()
			local char = LocalPlayer.Character
			if not char or char.Name ~= "Azure" then return end
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if not hrp then return end
			local survivors = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Survivors")
			if not survivors then return end
			local best, bestD = nil, math.huge
			for _, s in ipairs(survivors:GetChildren()) do
				local sHrp = s:FindFirstChild("HumanoidRootPart")
				local hum = s:FindFirstChildOfClass("Humanoid")
				if sHrp and hum and hum.Health > 0 then
					local d = (sHrp.Position - hrp.Position).Magnitude
					if d < bestD then bestD = d; best = sHrp end
				end
			end
			if best then
				local aimPos = Vector3.new(best.Position.X, hrp.Position.Y, best.Position.Z)
				hrp.CFrame = CFrame.new(hrp.Position, aimPos)
				Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, best.Position), 0.15)
			end
		end)
	end
end

