-- Noli
-- ============================================================
local noliState = {
	Enabled = false,
	AutoTarget = false,
	AntiCrash = false,
	DashSpeed = 60,
	ControlStrength = 1,
	AutoNova = false,
	BindName = "HA_NoliRushControl",
	NovaConn = nil,
	lastNova = 0,
}

local function noliVecToDir(vec)
	if not vec then return nil end
	local flat = Vector3.new(vec.X, 0, vec.Z)
	if flat.Magnitude < 0.001 then return nil end
	return flat.Unit
end

local function noliCameraLookDir() return noliVecToDir(Camera.CFrame.LookVector) end

local function noliAngleBetween(a, b)
	if not a or not b then return math.pi end
	return math.acos(math.clamp(a:Dot(b), -1, 1))
end

local function noliFindNearestPlayer(hrp, selfChar, maxDist)
	local best, bestD = nil, maxDist or math.huge
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LocalPlayer and p.Character ~= selfChar then
			local pHrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			local pHum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
			if pHrp and pHum and pHum.Health > 0 then
				local d = (pHrp.Position - hrp.Position).Magnitude
				if d < bestD then bestD = d; best = p end
			end
		end
	end
	return best
end

local function noliSmoothDir(oldDir, newDir, dt, strength)
	if not oldDir then return newDir end
	if not newDir then return oldDir end
	local a = math.max(0.0001, dt)
	local alpha = math.clamp(a * 60 * strength, 0, 1)
	return oldDir:Lerp(newDir, alpha).Unit
end

local function noliSetCameraTo(dir)
	if not dir then return end
	local look = Camera.CFrame.LookVector
	if noliAngleBetween(look, dir) > 0.6 then
		Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, Camera.CFrame.Position + dir)
	end
end

local function noliRushLoop(dt)
	local char = LocalPlayer.Character
	if not char or char.Name ~= "Noli" then
		if noliState.dashingStarted then
			noliState.dashingStarted = false
			noliState.currentDir = nil
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hum then hum.AutoRotate = true hum.WalkSpeed = 16 end
		end
		return
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp or hum.Health <= 0 then return end

	local rushState = char:GetAttribute("VoidRushState")
	if rushState ~= "Charging" and rushState ~= "Dashing" then
		if noliState.dashingStarted then
			noliState.dashingStarted = false
			noliState.currentDir = nil
			hum.AutoRotate = true
			hum.WalkSpeed = 16
		end
		return
	end

	if rushState == "Charging" then
		if not noliState.chargingStarted then
			noliState.chargingStarted = true
			noliState.dashingStarted = false
			noliState.currentDir = nil
		end
		if noliState.AutoTarget then
			local nearest = noliFindNearestPlayer(hrp, char, 200)
			if nearest and nearest.Character then
				local tHrp = nearest.Character:FindFirstChild("HumanoidRootPart")
				if tHrp then
					local dir = noliVecToDir(tHrp.Position - hrp.Position)
					noliState.currentDir = noliSmoothDir(noliState.currentDir, dir, dt, noliState.ControlStrength)
					noliSetCameraTo(noliState.currentDir)
					hum:Move(noliState.currentDir)
				end
			end
		end
	elseif rushState == "Dashing" then
		if not noliState.dashingStarted then
			noliState.dashingStarted = true
			hum.AutoRotate = false
			if noliState.Enabled then hum.WalkSpeed = noliState.DashSpeed end
			noliState.dashStartTime = os.clock()
			local fwd = hrp.CFrame.LookVector
			noliState.currentDir = noliVecToDir(fwd)
		end

		local desired
		if noliState.AutoTarget then
			local nearest = noliFindNearestPlayer(hrp, char, 200)
			if nearest and nearest.Character then
				local tHrp = nearest.Character:FindFirstChild("HumanoidRootPart")
				if tHrp then
					desired = noliVecToDir(tHrp.Position - hrp.Position)
				end
			end
		elseif noliState.Enabled then
			desired = noliCameraLookDir()
		end

		if desired then
			local strength = noliState.Enabled and 1 or (noliState.AutoTarget and 0.5 or 1)
			noliState.currentDir = noliSmoothDir(noliState.currentDir, desired, dt, strength)
		end

		if noliState.currentDir then
			if noliAngleBetween(hrp.CFrame.LookVector, noliState.currentDir) > 0.6 then
				hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + noliState.currentDir)
			end
			local vel = noliState.currentDir * noliState.DashSpeed
			hrp.AssemblyLinearVelocity = Vector3.new(vel.X, hrp.AssemblyLinearVelocity.Y, vel.Z)
			for _, c in ipairs(hrp:GetChildren()) do
				if c:IsA("BodyVelocity") then c.Velocity = vel
				elseif c:IsA("LinearVelocity") then c.VectorVelocity = vel end
			end
			hum:Move(noliState.currentDir)
			if noliState.AutoTarget then noliSetCameraTo(noliState.currentDir) end
		end
	end
end

local function noliEnable()
	pcall(function() RunService:UnbindFromRenderStep(noliState.BindName) end)
	RunService:BindToRenderStep(noliState.BindName, Enum.RenderPriority.Camera.Value + 2, noliRushLoop)
end

local function noliDisable()
	pcall(function() RunService:UnbindFromRenderStep(noliState.BindName) end)
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then hum.AutoRotate = true hum.WalkSpeed = 16 end
	noliState.dashingStarted = false
	noliState.chargingStarted = false
	noliState.currentDir = nil
end

local function noliUpdate()
	if noliState.Enabled or noliState.AutoTarget then noliEnable() else noliDisable() end
end

local function noliSetAntiCrash(on)
	noliState.AntiCrash = on
	if not on then return end
	if not _G.__HA_noliHooked and hookmetamethod and getnamecallmethod then
		_G.__HA_noliHooked = true
		local ok, mt = pcall(getrawmetatable, game)
		if not ok or not mt then return end
		local old = mt.__namecall
		setreadonly(mt, false)
		mt.__namecall = newcclosure(function(self, ...)
			if getnamecallmethod() == "FireServer" then
				local args = { ... }
				if type(args[1]) == "string" and string.find(args[1], "VoidRushCollision") then
					if type(args[3]) == "table" then return end
				end
			end
			return old(self, ...)
		end)
		setreadonly(mt, true)
	end
end

local function noliSetAutoNova(on)
	noliState.AutoNova = on
	if noliState.NovaConn then noliState.NovaConn:Disconnect() noliState.NovaConn = nil end
	if not on then return end

	pcall(function()
		require(ReplicatedStorage.Systems.Player.Game.ProjectileReplication)
	end)

	noliState.NovaConn = RunService.Heartbeat:Connect(function()
		local ok, mod = pcall(function()
			return require(ReplicatedStorage.Systems.Player.Game.ProjectileReplication)
		end)
		if not ok or not mod or not mod.Projectiles then return end
		local myRoot = getRoot(LocalPlayer.Character)
		if not myRoot then return end
		for _, v in pairs(mod.Projectiles) do
			if v and (v.Running ~= false or v.State == "Running") then
				local name = v.Model and v.Model.Name or ""
				if type(name) == "string" and (string.find(string.lower(name), "nova") or string.find(string.lower(name), "star") or string.find(string.lower(name), "void")) then
					if os.clock() - noliState.lastNova > 0.1 then
						noliState.lastNova = os.clock()
						if REMOTE then
							REMOTE:FireServer("UseActorAbility", { buffer.fromstring(string.pack("<Bi4", 3, #"Nova") .. "Nova") })
						end
					end
					break
				end
			end
		end
	end)
end

