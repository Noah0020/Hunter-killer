local ckState = {
	AntiCollision = false,
	OverrideControl = false,
	CustomWalkSpeed = false,
	OverrideSpeed = 90,
	conn1 = nil,
	conn2 = nil,
}

local function ckSetAntiCollision(on)
	ckState.AntiCollision = on
	if not on then return end
	if not _G.__HA_ckHooked and hookmetamethod and getnamecallmethod then
		_G.__HA_ckHooked = true
		local ok, mt = pcall(getrawmetatable, game)
		if not ok or not mt then return end
		local old = mt.__namecall
		setreadonly(mt, false)
		mt.__namecall = newcclosure(function(self, ...)
			if ckState.AntiCollision and getnamecallmethod() == "FireServer" and self.ClassName == "RemoteEvent" then
				local args = { ... }
				if type(args[1]) == "string" and string.find(args[1], "C00lkiddCollision") then return end
			end
			return old(self, ...)
		end)
		setreadonly(mt, true)
	end
end

local function ckSetOverrideControl(on)
	ckState.OverrideControl = on
	if ckState.conn1 then ckState.conn1:Disconnect() ckState.conn1 = nil end
	if not on then return end
	ckState.conn1 = RunService.Stepped:Connect(function()
		local char = LocalPlayer.Character
		if not char or char.Name ~= "c00lkidd" then return end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end
		local lv = hrp:FindFirstChildWhichIsA("LinearVelocity")
		if lv then lv.LineDirection = Camera.CFrame.LookVector end
		local look = Camera.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude > 0 then
			hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + flat.Unit)
		end
	end)
end

local function ckSetCustomWalkSpeed(on)
	ckState.CustomWalkSpeed = on
	if ckState.conn2 then ckState.conn2:Disconnect() ckState.conn2 = nil end
	if not on then return end
	ckState.conn2 = RunService.Stepped:Connect(function()
		local char = LocalPlayer.Character
		if not char or char.Name ~= "c00lkidd" then return end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end
		local lv = hrp:FindFirstChildWhichIsA("LinearVelocity")
		if lv and lv:IsDescendantOf(char) then lv.LineVelocity = ckState.OverrideSpeed end
	end)
end

