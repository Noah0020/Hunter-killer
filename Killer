-- HELPERS
local function getRoot(m)
	return m and (m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart)
end

local function getRemoteEvent()
	local modules = ReplicatedStorage:FindFirstChild("Modules")
	if not modules then return nil end
	local net = modules:FindFirstChild("Network") or modules:WaitForChild("Network", 5)
	if not net then return nil end
	if net:IsA("ModuleScript") then
		local ok, mod = pcall(require, net)
		if ok and type(mod) == "table" and mod.RemoteEvent then
			return mod.RemoteEvent
		end
	end
	return net:FindFirstChild("RemoteEvent", true)
end

local REMOTE = getRemoteEvent()

