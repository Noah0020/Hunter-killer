-- JOHN DOE AIM
-- ============================================================
local johnDoeState = {
	Settings = {
		Enabled = false,
		VelocitySmooth = 0.15,
		AimSmoothness = 0.15,
		CorruptLeadTime = 0.5,
		CorruptPostWindup = 2.5,
		SpinAim = false,
		SpinSpeed = 20,
		DoubleStrike = false,
		DoubleStrikeSpeed = 25,
		DoubleStrikeWidth = 20,
	},
	State = {
		HooksInstalled = false,
		CurrentTarget = nil,
		AimEndTime = 0,
		VelocityTable = {},
	},
	Conn = { VelocityLoop = nil, AimLoop = nil },
}

local function jdTrackVelocity(tableRef, char, hrp, dt, smooth)
	if not hrp then tableRef[char] = nil return end
	local pos = hrp.Position
	local rec = tableRef[char]
	if not rec then
		tableRef[char] = { LastPos = pos, SmoothedVel = Vector3.zero }
	else
		rec.SmoothedVel = rec.SmoothedVel:Lerp((pos - rec.LastPos) / dt, smooth)
		rec.LastPos = pos
	end
end

local function jdStopAim()
	if johnDoeState.Conn.AimLoop then
		johnDoeState.Conn.AimLoop:Disconnect()
		johnDoeState.Conn.AimLoop = nil
	end
	johnDoeState.State.CurrentTarget = nil
end

local function jdGetTargetPosition(char)
	if not char then return Vector3.zero end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp then return Vector3.zero end
	local rec = johnDoeState.State.VelocityTable[char]
	local vel = rec and rec.SmoothedVel or hrp.AssemblyLinearVelocity
	if vel.Magnitude < 2 then return hrp.Position end
	return hrp.Position + vel * johnDoeState.Settings.CorruptLeadTime
end

local function jdAimLoop()
	local SS = johnDoeState.Settings
	local St = johnDoeState.State
	if not SS.Enabled or not St.CurrentTarget then jdStopAim() return end
	if tick() > St.AimEndTime then jdStopAim() return end
	local targetHrp = St.CurrentTarget:FindFirstChild("HumanoidRootPart")
	if not targetHrp then jdStopAim() return end
	local pos = jdGetTargetPosition(St.CurrentTarget)
	if pos == Vector3.zero then return end
	local myHrp = getRoot(LocalPlayer.Character)
	if not myHrp then return end
	local flat = Vector3.new(pos.X - myHrp.Position.X, 0, pos.Z - myHrp.Position.Z)
	if flat.Magnitude < 0.05 then return end

	local aimPoint = pos
	if SS.DoubleStrike then
		local look = (pos - myHrp.Position).Unit
		aimPoint = pos + CFrame.lookAt(Vector3.zero, look).RightVector
			* (math.sin(tick() * SS.DoubleStrikeSpeed) * SS.DoubleStrikeWidth)
	end

	local remaining = St.AimEndTime - tick()
	local targetCF = CFrame.lookAt(myHrp.Position, Vector3.new(aimPoint.X, myHrp.Position.Y, aimPoint.Z))

	if SS.SpinAim and remaining > 0.15 then
		myHrp.CFrame = myHrp.CFrame * CFrame.Angles(0, math.rad(SS.SpinSpeed), 0)
	else
		Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, pos), 0.2)
		myHrp.CFrame = myHrp.CFrame:Lerp(targetCF, SS.AimSmoothness)
	end
end

local function jdInstallHooks()
	if johnDoeState.State.HooksInstalled then return end
	local ok, behavior = pcall(function()
		return require(ReplicatedStorage.Assets.Killers.JohnDoe.Behavior)
	end)
	if not ok or type(behavior) ~= "table" then return end

	local target = behavior.Abilities and behavior.Abilities.CorruptEnergy
	if type(target) ~= "table" or type(target.Callback) ~= "function" then return end

	local original = target.Callback
	target.Callback = function(...)
		task.spawn(function()
			if not johnDoeState.Settings.Enabled then return end
			local survivors = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Survivors")
			if not survivors then return end
			local myRoot = getRoot(LocalPlayer.Character)
			if not myRoot then return end

			local best, bestD = nil, math.huge
			for _, s in ipairs(survivors:GetChildren()) do
				local hrp = s:FindFirstChild("HumanoidRootPart")
				local hum = s:FindFirstChildOfClass("Humanoid")
				if hrp and hum and hum.Health > 0 then
					local d = (hrp.Position - myRoot.Position).Magnitude
					if d < bestD then bestD = d; best = s end
				end
			end
			if not best then return end

			johnDoeState.State.CurrentTarget = best
			johnDoeState.State.AimEndTime = tick() + 0.7 + johnDoeState.Settings.CorruptPostWindup

			if not johnDoeState.Conn.AimLoop then
				johnDoeState.Conn.AimLoop = RunService.RenderStepped:Connect(jdAimLoop)
			end
		end)
		return original(...)
	end

	johnDoeState.State.HooksInstalled = true
end

local function jdSetEnabled(enabled)
	johnDoeState.Settings.Enabled = enabled
	if enabled then
		if not johnDoeState.Conn.VelocityLoop then
			johnDoeState.Conn.VelocityLoop = RunService.Heartbeat:Connect(function(dt)
				local survivors = Workspace:FindFirstChild("Players") and Workspace.Players:FindFirstChild("Survivors")
				if not survivors then return end
				for _, s in ipairs(survivors:GetChildren()) do
					jdTrackVelocity(johnDoeState.State.VelocityTable, s, s:FindFirstChild("HumanoidRootPart"), dt, johnDoeState.Settings.VelocitySmooth)
				end
			end)
		end
		task.spawn(jdInstallHooks)
	else
		if johnDoeState.Conn.VelocityLoop then
			johnDoeState.Conn.VelocityLoop:Disconnect()
			johnDoeState.Conn.VelocityLoop = nil
		end
		jdStopAim()
		johnDoeState.State.VelocityTable = {}
	end
end

